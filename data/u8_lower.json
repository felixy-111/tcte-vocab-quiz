  "readings": [
    {
      "id": "U8L-READ-1",
      "title": "Kevin's Big Lunch",
      "text": "Kevin is a student in the food program at a high school in Tainan. He takes after his mother. She is a great cook, and he wants to go after his dream of opening a small restaurant. Last month his class planned a lunch for the old people in town. The students gathered in the school kitchen early in the morning. Kevin made soup with plants from the school garden. He cooked the beef slowly to soften it. His friend Amy painted the menu on a plain white board. At first, one thing puzzled them: how could they make the food less salty? They decreased the salt and used more fresh vegetables. Their effort had a good effect. The old people loved the meal, and one man said it brought back a happy memory. Kevin will take care of the kitchen again next month."
    }
  ],
